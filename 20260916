    /** {{KEY}} 형태를 param 값으로 치환 */
    public static String render(String tmpl, Map<String, String> param) {
        if (tmpl == null) {
            return "";
        }
        String result = tmpl;
        for (Map.Entry<String, String> e : param.entrySet()) {
            result = replaceAll(result, "{{" + e.getKey() + "}}", nvl(e.getValue()));
        }
        return result;
    }

    /** 정규식 미사용 전체 치환 */
    public static String replaceAll(String src, String from, String to) {
        if (src == null || from == null || from.length() == 0) {
            return src;
        }
        StringBuilder sb = new StringBuilder(src.length());
        int pos = 0;
        while (true) {
            int idx = src.indexOf(from, pos);
            if (idx < 0) {
                sb.append(src.substring(pos));
                break;
            }
            sb.append(src, pos, idx).append(to);
            pos = idx + from.length();
        }
        return sb.toString();
    }

    /** HTML 이스케이프 */
    public static String esc(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }
        StringBuilder sb = new StringBuilder(s.length() + 16);
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '&') {
                sb.append("&amp;");
            } else if (c == '<') {
                sb.append("&lt;");
            } else if (c == '>') {
                sb.append("&gt;");
            } else if (c == '"') {
                sb.append("&quot;");
            } else {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    public static String nvl(String s) {
        return s == null ? "" : s;
    }

