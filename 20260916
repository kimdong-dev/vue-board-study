package com.secl.pms.batch.legacy.template;

import java.util.List;

import com.secl.pms.batch.vo.EepAlertItemVo;

/**
 * Digest / MultiProject 항목 리스트 표 HTML 생성
 */
public class EepMailTable {

    private EepMailTable() {
    }

    /**
     * 항목 리스트 표 생성
     * @param list      정렬 완료된 항목 목록
     * @param withPjt   프로젝트 컬럼 포함 여부 (MultiProject는 섹션 구분이므로 false 권장)
     * @param startNo   시작 번호
     */
    public static String build(List<EepAlertItemVo> list, boolean withPjt, int startNo) {
        StringBuilder sb = new StringBuilder(4096);

        sb.append("<table style=\"").append(EepMailTemplate.S_TABLE).append("\">");
        sb.append("<tr>");
        if (withPjt) {
            sb.append(th("프로젝트"));
        }
        sb.append(th("No"));
        sb.append(th("구분"));
        sb.append(th("명칭"));
        sb.append(th("관련 Key Task"));
        sb.append(th("단계"));
        sb.append(th("상태"));
        sb.append(th("필요 조치"));
        sb.append("</tr>");

        int no = startNo;
        for (int i = 0; i < list.size(); i++) {
            EepAlertItemVo vo = list.get(i);
            sb.append("<tr>");
            if (withPjt) {
                sb.append(tdC(vo.getVOrder()));
            }
            sb.append(tdC(String.valueOf(no)));
            sb.append(tdC(vo.getTypeNm()));
            sb.append(td(vo.getViewName()));
            sb.append(td(vo.getViewKeyTask()));
            sb.append(tdC(vo.getStageNm()));
            sb.append(td(vo.getStatusNm()));
            sb.append(td(vo.getActionNm()));
            sb.append("</tr>");
            no++;
        }

        sb.append("</table>");
        return sb.toString();
    }

    /** 프로젝트 섹션 헤더 */
    public static String section(String pjtNm, int cnt) {
        return "<div style=\"" + EepMailTemplate.S_SECTION + "\">"
             + EepMailTemplate.esc(pjtNm) + " (" + cnt + "건)</div>";
    }

    private static String th(String txt) {
        return "<th style=\"" + EepMailTemplate.S_TH + "\">" + txt + "</th>";
    }

    private static String td(String txt) {
        return "<td style=\"" + EepMailTemplate.S_TD + "\">" + EepMailTemplate.esc(txt) + "</td>";
    }

    private static String tdC(String txt) {
        return "<td style=\"" + EepMailTemplate.S_TD_C + "\">" + EepMailTemplate.esc(txt) + "</td>";
    }
}








