/**
 * EEP 설계진도 Risk Warning 알림 메일 Writer
 *
 * 처리 순서
 *   1. Processor 결과를 항목 VO 목록으로 변환 (마스터 미달 / 상세 미달 각각 1건씩)
 *   2. 수신자 조회용 파라미터(listParamMap) 구성
 *   3. 공종별 수신자(LE/그룹장/팀장) 조회
 *   4. 수신자 × 항목 매칭 → 수신자(사번) 단위로 묶음
 *   5. 수신자별로 메일 유형 판정 → 제목/본문 생성 → 로그 테이블 기록
 *
 * ※ 검증 단계이므로 실제 메일 발송(registerMail)은 주석 처리 상태.
 */
@SuppressWarnings({ "rawtypes", "unchecked" })
public class EepMailingWriter extends PmsAbstractStep implements ItemWriter<ProcessorResultVo> {

    private final static String SQL = "EEP_MAILING.";

    /** '설계본부'의 EPID (SELECT EPIP FROM SINGLE_USERINFO WHERE CN = '설계본부') */
    private final static String SENDER_EP_ID = "M200309045649D801776";

    /** 메일 제목/본문 컬럼 최대 바이트 */
    private final static int TITLE_MAX_BYTES = 2000;
    private final static int BODY_MAX_BYTES  = 4000;

    protected BatchMaillingService batchMaillingService;

    public void setBatchMaillingService(BatchMaillingService batchMaillingService) {
        this.batchMaillingService = batchMaillingService;
    }

    @Override
    public void write(List<? extends ProcessorResultVo> items) throws Exception {

        TransactionVo insertVo = new TransactionVo(this);
        String batchDt = new SimpleDateFormat("yyyyMMdd").format(new Date());

        for (ProcessorResultVo item : items) {
            int ifCnt = 0;  // 알림 대상 항목 수
            int prCnt = 0;  // 생성된 메일 수

            insertVo.setPjtNo(item.getPjtNo());
            insertVo.setVersion(item.getVersion());

            List targetList = item.getResultSet("eepPriDtlNotiTargetList");
            if (targetList == null || targetList.isEmpty()) {
                this.loggingPjtEnd(item.getPjtNo(), item.getVersion(), insertVo, ifCnt, prCnt);
                continue;
            }

            /* ---------- 1. 항목 VO 목록 생성 ---------- */
            List<EepAlertItemVo> alertList = createAlertList(targetList);
            ifCnt = alertList.size();

            /* ---------- 2. 수신자 조회 파라미터 구성 ---------- */
            insertVo.setListParamMap(createListParamMap(targetList));

            /* ---------- 3. 수신자 조회 ---------- */
            List rcvrList = sqlTemplate.selectList(SQL + "selectEepPriDtlNotiRcvrList", insertVo);
            if (rcvrList == null || rcvrList.isEmpty()) {
                this.loggingPjtEnd(item.getPjtNo(), item.getVersion(), insertVo, ifCnt, prCnt);
                continue;
            }

            /* ---------- 4. 수신자 × 항목 매칭 ---------- */
            Map<String, Map<String, Object>>         rcvrInfoMap = new LinkedHashMap<String, Map<String, Object>>();
            Map<String, Map<String, EepAlertItemVo>> rcvrItemMap = new LinkedHashMap<String, Map<String, EepAlertItemVo>>();

            matchRcvrAndItem(rcvrList, alertList, rcvrInfoMap, rcvrItemMap);

            /* ---------- 5. 수신자별 메일 생성 / 로그 기록 ---------- */
            for (Map.Entry<String, Map<String, EepAlertItemVo>> entry : rcvrItemMap.entrySet()) {
                String empno = entry.getKey();

                List<EepAlertItemVo> myList = new ArrayList<EepAlertItemVo>(entry.getValue().values());
                if (myList.isEmpty()) {
                    continue;
                }
                Collections.sort(myList, EepAlertItemVo.SORT);

                makeAndLogMail(batchDt, empno, rcvrInfoMap.get(empno), myList);
                prCnt++;
            }

            /* 작업 결과 기록 */
            this.loggingPjtEnd(item.getPjtNo(), item.getVersion(), insertVo, ifCnt, prCnt);
        }
    }

    /* ============================================================
     *  1. 항목 VO 목록 생성
     *     한 행에서 마스터 미달 / 상세 미달이 동시에 발생할 수 있으므로
     *     각각 별도의 VO로 생성한다.
     * ============================================================ */
    private List<EepAlertItemVo> createAlertList(List targetList) {
        List<EepAlertItemVo> result = new ArrayList<EepAlertItemVo>();
        Set<String> dupCheck = new LinkedHashSet<String>();

        for (Object obj : targetList) {
            Map<String, Object> row = (Map<String, Object>) obj;

            // Key Task(마스터) 미달 건
            if ("Y".equals(str(row.get("mstUnderYn")))) {
                EepAlertItemVo vo = EepAlertItemVo.create(row, EepAlertItemVo.GBN_KEYTASK);
                if (dupCheck.add(vo.getItemKey())) {
                    result.add(vo);
                }
            }

            // 상세관리항목 미달 건
            if ("Y".equals(str(row.get("dtlUnderYn")))) {
                EepAlertItemVo vo = EepAlertItemVo.create(row, EepAlertItemVo.GBN_ITEM);
                if (dupCheck.add(vo.getItemKey())) {
                    result.add(vo);
                }
            }
        }
        return result;
    }

    /* ============================================================
     *  2. 수신자 조회 파라미터 (PJT_NO + PRI_SEQ + PRI_DTL_SEQ)
     *     전 프로젝트 대상이므로 PJT_NO 필수
     * ============================================================ */
    private List<Map<String, Object>> createListParamMap(List targetList) {
        List<Map<String, Object>> result = new ArrayList<Map<String, Object>>();
        Set<String> dupCheck = new LinkedHashSet<String>();

        for (Object obj : targetList) {
            Map<String, Object> row = (Map<String, Object>) obj;

            String pjtNo     = str(row.get("pjtNo"));
            String priSeq     = str(row.get("priSeq"));
            String priDtlSeq = str(row.get("priDtlSeq"));

            String key = pjtNo + "_" + priSeq + "_" + priDtlSeq;
            if (dupCheck.add(key)) {
                Map<String, Object> param = new HashMap<String, Object>();
                param.put("pjtNo", pjtNo);
                param.put("priSeq", priSeq);
                param.put("priDtlSeq", priDtlSeq);
                result.add(param);
            }
        }
        return result;
    }

    /* ============================================================
     *  4. 수신자 × 항목 매칭
     *     - 수신자 1행 = (프로젝트, 관리항목, 구분(KEYTASK/ITEM), 공종) 단위
     *     - 해당 구분이 미달이고 공종이 일치하는 항목만 담는다
     *     - 팀장은 D-1주 / D-2주만 수신 (기획서 r2)
     * ============================================================ */
    private void matchRcvrAndItem(List rcvrList,
                                  List<EepAlertItemVo> alertList,
                                  Map<String, Map<String, Object>> rcvrInfoMap,
                                  Map<String, Map<String, EepAlertItemVo>> rcvrItemMap) {

        /* 항목을 (프로젝트|마스터순번|상세순번|구분) 키로 색인 */
        Map<String, List<EepAlertItemVo>> itemIndex = new HashMap<String, List<EepAlertItemVo>>();
        for (EepAlertItemVo vo : alertList) {
            String key = matchKey(vo.getPjtNo(), vo.getPriSeq(), vo.getPriDtlSeq(), vo.getOwnerGbn());
            List<EepAlertItemVo> bucket = itemIndex.get(key);
            if (bucket == null) {
                bucket = new ArrayList<EepAlertItemVo>();
                itemIndex.put(key, bucket);
            }
            bucket.add(vo);
        }

        for (Object obj : rcvrList) {
            Map<String, Object> rcvr = (Map<String, Object>) obj;

            String empno    = str(rcvr.get("empno"));
            String recvGbn  = str(rcvr.get("recvGbn"));   // LE / GROUP_MANAGER / TEAM_MANAGER
            String ownerGbn = str(rcvr.get("ownerGbn"));  // KEYTASK / ITEM
            String discCd   = str(rcvr.get("discCd"));    // 수신자 공종코드

            if (empno.length() == 0) {
                continue;
            }

            String key = matchKey(str(rcvr.get("pjtNo")), str(rcvr.get("priSeq")),
                                  str(rcvr.get("priDtlSeq")), ownerGbn);
            List<EepAlertItemVo> bucket = itemIndex.get(key);
            if (bucket == null) {
                continue;
            }

            for (EepAlertItemVo vo : bucket) {
                // 공종 일치 확인
                if (!discCd.equals(vo.getViewDisplnCd())) {
                    continue;
                }
                // 팀장은 D-1주 / D-2주만 발송
                if ("TEAM_MANAGER".equals(recvGbn) && vo.getWeeksBefore() > 2) {
                    continue;
                }

                // 수신자 기본정보는 첫 매칭 시점에 보관
                if (!rcvrInfoMap.containsKey(empno)) {
                    rcvrInfoMap.put(empno, rcvr);
                    rcvrItemMap.put(empno, new LinkedHashMap<String, EepAlertItemVo>());
                }
                // itemKey 기준 중복 제거 (공종 복수 매핑 시 같은 항목이 여러 번 매칭됨)
                rcvrItemMap.get(empno).put(vo.getItemKey(), vo);
            }
        }
    }

    private String matchKey(String pjtNo, String priSeq, String priDtlSeq, String ownerGbn) {
        return pjtNo + "|" + priSeq + "|" + priDtlSeq + "|" + ownerGbn;
    }

    /* ============================================================
     *  5. 수신자 1명분 메일 생성 + 로그 기록
     * ============================================================ */
    private void makeAndLogMail(String batchDt,
                                String empno,
                                Map<String, Object> rcvrInfo,
                                List<EepAlertItemVo> myList) throws Exception {

        /* ---------- 집계 ---------- */
        int n = myList.size();
        int immd = 0;   // 즉시조치
        int rcvy = 0;   // 만회조치
        int erly = 0;   // 조기점검

        boolean hasD1 = false;
        boolean hasD2 = false;
        boolean hasD4 = false;

        Set<String> pjtSet      = new LinkedHashSet<String>();  // 프로젝트 표기명
        Set<String> displnNmSet = new LinkedHashSet<String>();  // 공종명
        Set<String> displnCdSet = new LinkedHashSet<String>();  // 공종코드

        for (EepAlertItemVo vo : myList) {
            if (EepAlertItemVo.LVL_IMMD.equals(vo.getActionLvl())) {
                immd++;
            } else if (EepAlertItemVo.LVL_RCVY.equals(vo.getActionLvl())) {
                rcvy++;
            } else {
                erly++;
            }

            int w = vo.getWeeksBefore();
            if (w == 1) {
                hasD1 = true;
            } else if (w == 2) {
                hasD2 = true;
            } else if (w == 3 || w == 4) {
                hasD4 = true;
            }

            pjtSet.add(vo.getVOrder());
            displnNmSet.add(vo.getViewDisplnNm());
            displnCdSet.add(vo.getViewDisplnCd());
        }

        int m = pjtSet.size();
        String displnNm = join(displnNmSet, "/");
        String displnCd = join(displnCdSet, ",");

        /* ---------- 메일 유형 판정 ----------
         *   1건            → 단건 (ITEM / KEYTASK)
         *   2건 이상 + 1PJT → DIGEST
         *   2건 이상 + 2PJT → MULTI
         */
        String mailType;
        if (n == 1) {
            mailType = myList.get(0).isKeyTask() ? "KEYTASK" : "ITEM";
        } else if (m >= 2) {
            mailType = "MULTI";
        } else {
            mailType = "DIGEST";
        }

        /* ---------- 제목 / 본문 생성 ---------- */
        String title;
        String body;

        if ("ITEM".equals(mailType) || "KEYTASK".equals(mailType)) {
            EepAlertItemVo vo = myList.get(0);
            title = makeSingleTitle(vo);
            body  = makeSingleBody(vo);
        } else if ("DIGEST".equals(mailType)) {
            title = makeDigestTitle(hasD1, hasD2, hasD4, false, first(pjtSet), m, n);
            body  = makeDigestBody(myList, displnNm, n, immd, rcvy, erly);
        } else {
            title = makeDigestTitle(hasD1, hasD2, hasD4, true, first(pjtSet), m, n);
            body  = makeMultiBody(myList, displnNm, m, n, immd, rcvy, erly);
        }

        /* ---------- 로그 마스터 INSERT ---------- */
        Map<String, Object> logParam = new HashMap<String, Object>();
        logParam.put("batchDt", batchDt);
        logParam.put("rcvrEmpno", empno);
        logParam.put("rcvrNm", str(rcvrInfo.get("hname")));
        logParam.put("rcvrGbn", str(rcvrInfo.get("recvGbn")));
        logParam.put("rcvrDeptNm", str(rcvrInfo.get("sdeptnm")));
        logParam.put("rcvrDisplnCd", displnCd);
        logParam.put("rcvrDisplnNm", displnNm);
        logParam.put("mailType", mailType);
        logParam.put("mailLang", str(rcvrInfo.get("mailLang")));
        logParam.put("pjtCnt", Integer.valueOf(m));
        logParam.put("itemCnt", Integer.valueOf(n));
        logParam.put("immdCnt", Integer.valueOf(immd));
        logParam.put("rcvyCnt", Integer.valueOf(rcvy));
        logParam.put("erlyCnt", Integer.valueOf(erly));
        logParam.put("mailTitle", cutByBytes(title, TITLE_MAX_BYTES));
        logParam.put("mailBody", cutByBytes(body, BODY_MAX_BYTES));

        sqlTemplate.update(SQL + "insertEepPriNotiLog", logParam);

        Object logSeqObj = logParam.get("logSeq");
        long logSeq = (logSeqObj instanceof Number) ? ((Number) logSeqObj).longValue() : 0L;

        /* ---------- 로그 상세 INSERT ---------- */
        int itemNo = 1;
        for (EepAlertItemVo vo : myList) {
            Map<String, Object> dtlParam = new HashMap<String, Object>();
            dtlParam.put("logSeq", Long.valueOf(logSeq));
            dtlParam.put("itemNo", Integer.valueOf(itemNo));
            dtlParam.put("pjtNo", vo.getPjtNo());
            dtlParam.put("vOrder", vo.getVOrder());
            dtlParam.put("priSeq", vo.getPriSeq());
            dtlParam.put("mngItemNo", vo.getMngItemNo());
            dtlParam.put("priMngItemNm", vo.getPriMngItemNm());
            dtlParam.put("mstDisplnCd", vo.getMstDisplnCd());
            dtlParam.put("mstDisplnNm", vo.getMstDisplnNm());
            dtlParam.put("priDtlSeq", vo.getPriDtlSeq());
            dtlParam.put("priMngItemSubNm", vo.getPriMngItemSubNm());
            dtlParam.put("majDisplnCd", vo.getMajDisplnCd());
            dtlParam.put("displnNm", vo.getDisplnNm());
            dtlParam.put("ownerGbn", vo.getOwnerGbn());
            dtlParam.put("planDt", vo.getPlanDt());
            dtlParam.put("weeksBefore", Integer.valueOf(vo.getWeeksBefore()));
            dtlParam.put("ver", vo.getVer());
            dtlParam.put("dsnComp", vo.getViewComp());
            dtlParam.put("compLimit", Integer.valueOf(vo.getCompLimit()));
            dtlParam.put("actionLvl", vo.getActionLvl());
            dtlParam.put("stageNm", vo.getStageNm());
            dtlParam.put("statusNm", vo.getStatusNm());
            dtlParam.put("actionNm", vo.getActionNm());

            sqlTemplate.update(SQL + "insertEepPriNotiLogDtl", dtlParam);
            itemNo++;
        }

        /* ---------- 실제 메일 발송 (검증 완료 후 활성화) ---------- */
        /*
        Map<String, Object> mailParam = new HashMap<String, Object>();
        mailParam.put("sender_ep_id", SENDER_EP_ID);
        mailParam.put("title", title);
        mailParam.put("contents", body);

        List<String> rcvEmpList = new ArrayList<String>();
        rcvEmpList.add(empno);
        mailParam.put("rcvList", rcvEmpList);

        // 개발자, PI 비밀참조
        Map<String, Object> secretRcvMap = new HashMap<String, Object>();
        secretRcvMap.put("20070724", "Y"); // 구서영
        secretRcvMap.put("20110747", "Y"); // 유병철
        secretRcvMap.put("T13621", "Y");   // 한승동
        secretRcvMap.put("T08722", "Y");   // 김동진
        mailParam.put("secretRcvMap", secretRcvMap);

        batchMaillingService.registerMail(mailParam);
        */
    }

    /* ============================================================
     *  제목 생성
     * ============================================================ */

    /** 단건 제목 */
    private String makeSingleTitle(EepAlertItemVo vo) {
        String tmpl = EepMailTemplate.pickSingleSubject(vo.isKeyTask(), vo.getWeeksBefore(), vo.getVer());

        Map<String, String> p = new HashMap<String, String>();
        p.put("PJT", vo.getVOrder());
        p.put("ITEM_NM", vo.getPriMngItemSubNm());
        p.put("KEYTASK_NM", vo.getPriMngItemNm());

        return EepMailTemplate.render(tmpl, p);
    }

    /** Digest / MultiProject 제목 */
    private String makeDigestTitle(boolean hasD1, boolean hasD2, boolean hasD4,
                                   boolean isMulti, String pjtNm, int m, int n) {
        String tmpl = EepMailTemplate.pickDigestSubject(hasD1, hasD2, hasD4, isMulti);

        Map<String, String> p = new HashMap<String, String>();
        p.put("PJT", pjtNm);
        p.put("M", String.valueOf(m));
        p.put("N", String.valueOf(n));

        return EepMailTemplate.render(tmpl, p);
    }

    /* ============================================================
     *  본문 생성
     * ============================================================ */

    /** 단건 본문 */
    private String makeSingleBody(EepAlertItemVo vo) {
        String tmpl;

        if (vo.isKeyTask()) {
            /* KeyTask Owner
             *   D-6/4/2 : 지연 관리항목이 본인 소관 공종인지
             *   D-1     : Key Task가 단일 공종인지 (※ 현업 확인 대기 항목)
             *   현재는 마스터 공종 == 상세 공종 여부로 판정
             */
            boolean ownScope = vo.getMstDisplnCd().equals(vo.getMajDisplnCd());
            tmpl = EepMailBody.pickKeyTaskBody(vo.getWeeksBefore(), vo.getVer(), ownScope);
        } else {
            /* Item Owner : Key Task 공종 == 관리항목 공종 (LE=본인) */
            boolean sameDispln = vo.getMstDisplnCd().equals(vo.getMajDisplnCd());
            tmpl = EepMailBody.pickItemBody(vo.getWeeksBefore(), vo.getVer(), sameDispln);
        }

        Map<String, String> p = new HashMap<String, String>();
        p.put("ITEM_NM", EepMailTemplate.esc(vo.getPriMngItemSubNm()));
        p.put("KEYTASK_NM", EepMailTemplate.esc(vo.getPriMngItemNm()));
        p.put("DELAY_ITEM_NM", EepMailTemplate.esc(vo.getPriMngItemSubNm()));
        p.put("DELAY_SCOPE", vo.getMstDisplnCd().equals(vo.getMajDisplnCd()) ? "본인 소관" : "타 공종 소관");

        String inner = EepMailTemplate.render(tmpl, p);
        String head  = EepMailBody.pickHead(vo.getWeeksBefore(), vo.getVer());

        return EepMailTemplate.wrap(head, inner);
    }

    /** Digest 본문 (단일 프로젝트) */
    private String makeDigestBody(List<EepAlertItemVo> myList, String displnNm,
                                  int n, int immd, int rcvy, int erly) {

        Map<String, String> p = new HashMap<String, String>();
        p.put("DISPLN_NM", EepMailTemplate.esc(displnNm));
        p.put("N", String.valueOf(n));
        p.put("X", String.valueOf(immd));
        p.put("Y", String.valueOf(rcvy));
        p.put("Z", String.valueOf(erly));
        p.put("TABLE", EepMailTable.build(myList, false, 1));

        String inner = EepMailTemplate.render(EepMailBody.KR_DIGEST, p);
        return EepMailTemplate.wrap(EepMailTemplate.HEAD_DIGEST, inner);
    }

    /** MultiProject Digest 본문 (프로젝트별 섹션 반복) */
    private String makeMultiBody(List<EepAlertItemVo> myList, String displnNm,
                                 int m, int n, int immd, int rcvy, int erly) {

        /* 프로젝트별로 묶기. myList는 이미 우선순위 순으로 정렬되어 있으므로
         * LinkedHashMap을 쓰면 리스크가 높은 프로젝트가 자연스럽게 위로 온다. */
        Map<String, List<EepAlertItemVo>> pjtMap = new LinkedHashMap<String, List<EepAlertItemVo>>();
        for (EepAlertItemVo vo : myList) {
            String pjtNm = vo.getVOrder();
            List<EepAlertItemVo> bucket = pjtMap.get(pjtNm);
            if (bucket == null) {
                bucket = new ArrayList<EepAlertItemVo>();
                pjtMap.put(pjtNm, bucket);
            }
            bucket.add(vo);
        }

        StringBuilder sections = new StringBuilder(8192);
        for (Map.Entry<String, List<EepAlertItemVo>> e : pjtMap.entrySet()) {
            List<EepAlertItemVo> sub = e.getValue();
            sections.append(EepMailTable.section(e.getKey(), sub.size()));
            sections.append(EepMailTable.build(sub, false, 1));
        }

        Map<String, String> p = new HashMap<String, String>();
        p.put("DISPLN_NM", EepMailTemplate.esc(displnNm));
        p.put("M", String.valueOf(m));
        p.put("N", String.valueOf(n));
        p.put("X", String.valueOf(immd));
        p.put("Y", String.valueOf(rcvy));
        p.put("Z", String.valueOf(erly));
        p.put("SECTIONS", sections.toString());

        String inner = EepMailTemplate.render(EepMailBody.KR_MULTI, p);
        return EepMailTemplate.wrap(EepMailTemplate.HEAD_DIGEST, inner);
    }

    /* ============================================================
     *  util
     * ============================================================ */

    private String str(Object o) {
        return o == null ? "" : String.valueOf(o);
    }

    private String first(Set<String> set) {
        for (String s : set) {
            return s;
        }
        return "";
    }

    private String join(Set<String> set, String sep) {
        StringBuilder sb = new StringBuilder();
        for (String s : set) {
            if (s == null || s.length() == 0) {
                continue;
            }
            if (sb.length() > 0) {
                sb.append(sep);
            }
            sb.append(s);
        }
        return sb.toString();
    }

    /** UTF-8 바이트 기준으로 자르고 넘치면 "..." 붙임 (한글 경계 안전) */
    private String cutByBytes(String src, int maxBytes) {
        if (src == null) {
            return null;
        }
        byte[] bytes;
        try {
            bytes = src.getBytes("UTF-8");
        } catch (UnsupportedEncodingException e) {
            return src;
        }
        if (bytes.length <= maxBytes) {
            return src;
        }

        int limit = maxBytes - 3; // "..." 자리 확보
        // UTF-8 연속바이트(10xxxxxx) 위면 문자 시작 지점까지 뒤로
        while (limit > 0 && (bytes[limit] & 0xC0) == 0x80) {
            limit--;
        }

        try {
            return new String(bytes, 0, limit, "UTF-8") + "...";
        } catch (UnsupportedEncodingException e) {
            return src;
        }
    }
}





