<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ include file="/WEB-INF/pages/app/taglib.jsp" %>
<%--
    화면명 : TPMS입력시스템 > EP 시스템 > 설계 EP > 관리항목 알람메일 발송로그
    작성일 : 2026. 09. 16
    설계진도 Risk Warning 알림메일 발송 로그를 조회하는 화면
--%>

<style>
    #listTable td {
        text-overflow: ellipsis; overflow: hidden; white-space: nowrap;
    }
    /* [수정4] 헤더명 줄바꿈 안되게 한줄 고정 */
    #listTable th {
        white-space: nowrap;
    }

    /* 모달 내 상세 항목 표 */
    #dtlTable {
        width: 100%; border-collapse: collapse; font-size: 11px;
    }
    #dtlTable th {
        padding: 6px 4px; background-color: #4A4A4A; color: #FFF;
        /* [수정3] border색이 배경색(#4A4A4A)이랑 같아서 안보였음 -> 밝은색으로 변경 */
        border: 1px solid #6E6E6E; white-space: nowrap; font-weight: normal;
    }
    #dtlTable td {
        padding: 6px 4px; border: 1px solid #D8D8D8; vertical-align: top;
    }
    .dtl-c { text-align: center; white-space: nowrap; }

    /* 메일 본문 미리보기 iframe */
    #mailPreview {
        width: 100%; height: 520px; border: 1px solid #D8D8D8; background: #FFF;
    }
    .log-info-box {
        padding: 10px 14px; background-color: #F6F6F6;
        border: 1px solid #E0E0E0; margin-bottom: 10px; font-size: 12px;
    }
    .log-info-box span.lbl {
        display: inline-block; min-width: 70px; color: #767676;
    }
    .badge-send-y { color: #1F6FB2; font-weight: bold; }
    .badge-send-n { color: #999999; }
</style>

<div class="row col m-0 p-0">
    <div class="col m-0 p-0">
        <div class="d-block w30 bg_col_main h3px mb-2"></div>
        <span class="font-weight-bold font_12pt" id="title">관리항목 알람메일 발송로그</span>
    </div>
</div>

<!-- 상세 모달 -->
<div id="logDtlModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered" role="document">
        <div class="modal-content" style="min-width:900px; height:auto;">
            <div class="modal-header">
                <h5 class="modal-title">알람메일 상세</h5>
                <span class="modal_close_btn" data-dismiss="modal" aria-label="Close"></span>
            </div>
            <div class="modal-body">
                <div class="log-info-box" id="dtlInfoBox"></div>

                <ul class="nav nav-tabs" id="dtlTab">
                    <li class="nav-item">
                        <a class="nav-link active" data-toggle="tab" href="#tabItem">대상 항목</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="tab" href="#tabBody">메일 본문</a>
                    </li>
                </ul>
                <div class="tab-content pt-3">
                    <div class="tab-pane fade show active" id="tabItem">
                        <table id="dtlTable">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>프로젝트</th>
                                    <th>구분</th>
                                    <th>명칭</th>
                                    <th>관련 Key Task</th>
                                    <th>공종</th>
                                    <th>Plan일자</th>
                                    <th>단계</th>
                                    <th>완성도</th>
                                    <th>임계값</th>
                                    <th>상태</th>
                                    <th>필요 조치</th>
                                </tr>
                            </thead>
                            <tbody id="dtlTableBody"></tbody>
                        </table>
                    </div>
                    <div class="tab-pane fade" id="tabBody">
                        <iframe id="mailPreview" frameborder="0"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 검색조건 -->
<div class="current_info" style="gap: 0px;">
    <div class="d-inline-block py3 mr10">
        <label class="font_10pt mr15">
            <i class="fas fa-caret-right"></i> 프로젝트 :
        </label>
        <select id="srchPjtNo" class="selectpicker_custom selectpicker" data-width="200px">
            <option value="" selected>전체</option>
            <c:forEach var="item" items="${pjtList}">
                <option value='${item.pjt_no}'>[<c:out value="${item.pjt_no}"/>] ${item.pjt_short_name}</option>
            </c:forEach>
        </select>
    </div>
    <div class="d-inline-block py3 mr10">
        <label class="font_10pt mr15">
            <i class="fas fa-caret-right"></i> 공종 :
        </label>
        <select id="srchDisplnCd" class="selectpicker_custom selectpicker" data-width="120px">
            <option value="" selected>전공종</option>
            <c:forEach var="item" items="${disciplineDtlList}">
                <option value='${item.displn_cd}'>${item.displn_nm}</option>
            </c:forEach>
        </select>
    </div>
    <div class="d-inline-block py3 mr10">
        <label class="font_10pt">
            <i class="fas fa-caret-right mr5"></i>배치일자
        </label>
        <fmt:parseDate value="${yyyymmdd_from}" var="cutOffFromDt" pattern="yyyyMMdd"/>
        <input name="yyyymmdd_from" class="form-control form-control-sm d-inline-block w100 vertical-align-middle" id="yyyymmdd_from" type="text"
               value="<fmt:formatDate value="${cutOffFromDt}" pattern="yyyy.MM.dd"/>">
        ~
        <fmt:parseDate value="${yyyymmdd_to}" var="cutOffToDt" pattern="yyyyMMdd"/>
        <input name="yyyymmdd_to" class="form-control form-control-sm d-inline-block w100 vertical-align-middle" id="yyyymmdd_to" type="text"
               value="<fmt:formatDate value="${cutOffToDt}" pattern="yyyy.MM.dd"/>">
    </div>
    <div class="d-inline-block py3 mr10">
        <label class="font_10pt mr15">
            <i class="fas fa-caret-right"></i> 실행시각 :
        </label>
        <select id="srchRunKey" class="selectpicker_custom selectpicker" data-width="190px">
            <option value="" selected>전체</option>
        </select>
    </div>
</div>

<div class="current_info" style="gap: 0px;">
    <div class="d-inline-block py3 mr10">
        <label class="font_10pt mr15">
            <i class="fas fa-caret-right"></i> Key Task :
        </label>
        <!-- [수정6] 초기값 '전체'로 통일 (selected 누락 상태였음) -->
        <select id="srchPriSeq" class="selectpicker_custom selectpicker" data-width="200px">
            <option value="" selected>전체</option>
        </select>
    </div>
    <div class="d-inline-block py3 mr10">
        <label class="font_10pt mr15">
            <i class="fas fa-caret-right"></i> 관리항목 :
        </label>
        <!-- [수정6] 초기값 '전체'로 통일 (selected 누락 상태였음) -->
        <select id="srchPriDtlSeq" class="selectpicker_custom selectpicker" data-width="200px">
            <option value="" selected>전체</option>
        </select>
    </div>
    <div class="d-inline-block py3 mr10">
        <label class="font_10pt mr15">
            <i class="fas fa-caret-right"></i> 메일유형 :
        </label>
        <select id="srchMailType" class="selectpicker_custom selectpicker" data-width="130px">
            <option value="" selected>전체</option>
            <option value="ITEM">관리항목(단건)</option>
            <option value="KEYTASK">Key Task(단건)</option>
            <option value="DIGEST">Digest</option>
            <option value="MULTI">Multi PJT</option>
        </select>
    </div>
    <div class="d-inline-block py3 mr10">
        <label class="font_10pt mr15">
            <i class="fas fa-caret-right"></i> 수신자구분 :
        </label>
        <select id="srchRcvrGbn" class="selectpicker_custom selectpicker" data-width="100px">
            <option value="" selected>전체</option>
            <option value="LE">LE</option>
            <option value="GROUP_MANAGER">그룹장</option>
            <option value="TEAM_MANAGER">팀장</option>
        </select>
    </div>
    <div class="d-inline-block py3 mr10">
        <label class="font_10pt mr15">
            <i class="fas fa-caret-right"></i> 발송여부 :
        </label>
        <select id="srchSendYn" class="selectpicker_custom selectpicker" data-width="80px">
            <option value="" selected>전체</option>
            <option value="Y">Y</option>
            <option value="N">N</option>
        </select>
    </div>
    <div class="d-inline-block py3 mr10">
        <label class="font_10pt mr15">
            <i class="fas fa-caret-right"></i> 수신자 :
        </label>
        <input name="srchRcvr" class="form-control form-control-sm d-inline-block w140 vertical-align-middle" id="srchRcvr" type="text"
               placeholder="사번 / 성명" onkeydown="if(event.keyCode==13){searchList();}">
    </div>
    <div class="d-inline-block py3">
        <button type="button" class="btn btn-sm btn-dark" id="btnSearch" onclick="searchList();">
            <i class="fas fa-search"></i> 검색
        </button>
        <button class="btn btn-sm btn-dark pageMenuButton mr5" data-action="excelDown">
            <i class="fas fa-file-excel mr5"></i> 엑셀
        </button>
    </div>
</div>

<div class="row col m-0 p-0">
    <div class="w100p p-0 position-relative">
        <div class="w100p">
            <!-- [수정4] table-layout:fixed 상태에서 colResizable 적용해서 드래그로 컬럼폭 조절 가능하게 함 -->
            <table id="listTable" class="dark_type font_11pt w100p" style="table-layout:fixed;" border="0" cellpadding="0" cellspacing="0">
                <colgroup>
                    <col width="8%">
                    <col width="5%">
                    <col width="9%">
                    <col width="6%">
                    <col width="9%">
                    <col width="7%">
                    <col width="9%">
                    <col width="5%">
                    <col width="4%">
                    <col width="7%">
                    <col width="26%">
                    <col width="5%">
                </colgroup>
                <thead>
                    <tr>
                        <th>배치일자</th>
                        <th>실행<br/>시각</th>
                        <th>수신자</th>
                        <th>구분</th>
                        <th>부서</th>
                        <th>공종</th>
                        <th>메일유형</th>
                        <th>프로젝트</th>
                        <th>항목<br/>수</th>
                        <th>즉시/만회<br/>/조기</th>
                        <th>제목</th>
                        <th>발송</th>
                    </tr>
                </thead>
            </table>
        </div>
        <span class="lineH1px"></span>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function(){
        $('select').selectpicker();

        $("#yyyymmdd_from, #yyyymmdd_to").datepicker({
            dateFormat : "yy.mm.dd",
            showOn : "both",
            maxDate: 0,
            buttonImageOnly : true,
            buttonImage : "/cube_bta/lib/tpms/images/icon_cal.gif",
            buttonText : "Calendar",
            onSelect: function (dateText, inst) {
                loadRunTimeList();
            }
        });

        /* 프로젝트 변경 시 : Key Task 목록 재조회 */
        $("#srchPjtNo").on("change", function(){
            loadKeyTaskList();
        });

        /* Key Task 변경 시 : 하위 관리항목 목록 재조회 */
        /* [수정6] Key Task/관리항목 변경 시 바로 검색되도록 searchList() 추가 */
        $("#srchPriSeq").on("change", function(){
            loadItemList();
            searchList();
        });
        $("#srchPriDtlSeq").on("change", function(){
            searchList();
        });

        $('button.pageMenuButton').click(function() {
            var action = $(this).data('action');
            switch (action) {
                case "excelDown":
                    pageParams.excelDownload();
                    break;
            }
        });

        /* 초기 콤보 로드 */
        loadRunTimeList();
        loadKeyTaskList();

        var page_params = function() {
            /* excel data setting */
            this.getExcelParams = function() {
                var paramStr = "";
                paramStr += "srch_pjt_no=" + $("#srchPjtNo").val() + "&";
                paramStr += "srch_displn_cd=" + $("#srchDisplnCd").val() + "&";
                paramStr += "srch_from_dt=" + $("#yyyymmdd_from").val() + "&";
                paramStr += "srch_to_dt=" + $("#yyyymmdd_to").val() + "&";
                paramStr += "srch_run_key=" + $("#srchRunKey").val() + "&";
                paramStr += "srch_pri_seq=" + $("#srchPriSeq").val() + "&";
                paramStr += "srch_pri_dtl_seq=" + $("#srchPriDtlSeq").val() + "&";
                paramStr += "srch_mail_type=" + $("#srchMailType").val() + "&";
                paramStr += "srch_rcvr_gbn=" + $("#srchRcvrGbn").val() + "&";
                paramStr += "srch_send_yn=" + $("#srchSendYn").val() + "&";
                paramStr += "srch_rcvr=" + encodeURIComponent($("#srchRcvr").val()) + "&";
                paramStr += "excel_nm=" + encodeURIComponent($("#title").text()) + "&";

                return paramStr.substring(0, paramStr.length - 1);
            }
            /* 엑셀받기 */
            this.excelDownload = function() {
                tpmsCommon.goLocationPage("/cube_bta/tpmswork/ep/eep/mailing/keyTaskMailing/keyTaskLogExcel", this.getExcelParams());
            }
        };

        var pageParams = new page_params();
        window.pageParams = pageParams;

        $("#listTable").DataTable({
            "autoWidth": false,
            "searching": false,
            "language" : { "info" : "Total : _MAX_", "infoEmpty": "Total : 0" },
            "info": true,
            "paging": false,
            "ordering": false,
            "serverSide": false,
            "processing": true,
            "ajax": {
                "type": "POST",
                "url": "/cube_bta/tpmswork/ep/eep/mailing/keyTaskMailing/selectKeyTaskLogList",
                "data": function() {
                    var params = {
                        "srch_pjt_no": $("#srchPjtNo").val()
                        , "srch_displn_cd": $("#srchDisplnCd").val()
                        , "srch_from_dt": $("#yyyymmdd_from").val()
                        , "srch_to_dt": $("#yyyymmdd_to").val()
                        , "srch_run_key": $("#srchRunKey").val()
                        , "srch_pri_seq": $("#srchPriSeq").val()
                        , "srch_pri_dtl_seq": $("#srchPriDtlSeq").val()
                        , "srch_mail_type": $("#srchMailType").val()
                        , "srch_rcvr_gbn": $("#srchRcvrGbn").val()
                        , "srch_send_yn": $("#srchSendYn").val()
                        , "srch_rcvr": $("#srchRcvr").val()
                    };
                    return JSON.stringify(params);
                },
                "contentType": "application/json+lego; charset=UTF-8",
                "dataSrc": function(json) {
                    return json.list;
                }
            },
            "columns": [
                { "data": "batch_dt_nm", "className": "text-center" }
                , { "data": "run_tm", "className": "text-center" }
                , {
                    "data": "rcvr_nm", "className": "text-center",
                    "render": function(data, type, row) {
                        var nm = data != null ? data : "";
                        return nm + " (" + (row.rcvr_empno != null ? row.rcvr_empno : "") + ")";
                    }
                }
                , { "data": "rcvr_gbn_nm", "className": "text-center" }
                , { "data": "rcvr_dept_nm", "className": "text-center" }
                , { "data": "rcvr_displn_nm", "className": "text-center" }
                , { "data": "mail_type_nm", "className": "text-center" }
                , {
                    "data": "pjt_short_name", "className": "text-center",
                    "render": function(data, type, row) {
                        var v = data != null ? data : "";
                        return '<span title="' + v + '">' + v + '</span>';
                    }
                }
                , { "data": "item_cnt", "className": "text-center" }
                , { "data": "action_cnt_nm", "className": "text-center" }
                , {
                    "data": "mail_title", "className": "text-left",
                    "render": function(data, type, row) {
                        var v = data != null ? data : "";
                        return '<span title="' + v + '">' + v + '</span>';
                    }
                }
                , {
                    "data": "send_yn", "className": "text-center",
                    "render": function(data, type, row) {
                        if (data == 'Y') {
                            return '<span class="badge-send-y">Y</span>';
                        }
                        return '<span class="badge-send-n">N</span>';
                    }
                }
            ],
            "createdRow": function(row, data, dataIndex) {
                $(row).css("cursor", "pointer");
                $(row).on("click", function() {
                    openDtlModal(data.log_seq);
                });
            }
        });

        /* [수정4] 컬럼별 가로사이즈 드래그 조절 (colResizable 플러그인 필요 - 미도입 상태면 스크립트 추가 필요) */
        $("#listTable").colResizable({ liveDrag: true, resizeMode: 'fit' });
    });

    /* 목록 재조회 */
    function searchList() {
        $("#listTable").DataTable().ajax.reload();
    }

    /* 실행시각 콤보 로드 */
    function loadRunTimeList() {
        var params = {
            "srch_from_dt": $("#yyyymmdd_from").val()
            , "srch_to_dt": $("#yyyymmdd_to").val()
        };

        $.ajax({
            type: "POST",
            url: "/cube_bta/tpmswork/ep/eep/mailing/keyTaskMailing/selectKeyTaskLogRunTimeList",
            contentType: "application/json+lego; charset=UTF-8",
            data: JSON.stringify(params),
            success: function(json) {
                var html = '<option value="" selected>전체</option>';
                var list = json.list;
                if (list != null) {
                    for (var i = 0; i < list.length; i++) {
                        html += '<option value="' + list[i].run_key + '">' + list[i].run_nm + '</option>';
                    }
                }
                $("#srchRunKey").html(html);
                $("#srchRunKey").selectpicker("refresh");
            }
        });
    }

    /* Key Task 콤보 로드 */
    function loadKeyTaskList() {
        var params = { "srch_pjt_no": $("#srchPjtNo").val() };

        $.ajax({
            type: "POST",
            url: "/cube_bta/tpmswork/ep/eep/mailing/keyTaskMailing/selectKeyTaskLogTaskList",
            contentType: "application/json+lego; charset=UTF-8",
            data: JSON.stringify(params),
            success: function(json) {
                var html = '<option value="" selected>전체</option>';
                var list = json.list;
                if (list != null) {
                    for (var i = 0; i < list.length; i++) {
                        html += '<option value="' + list[i].pri_seq + '">' + list[i].pri_mng_item_nm + '</option>';
                    }
                }
                $("#srchPriSeq").html(html);
                $("#srchPriSeq").selectpicker("refresh");

                /* Key Task가 초기화되었으므로 하위 관리항목도 다시 로드 */
                loadItemList();
            }
        });
    }

    /* 하위 관리항목 콤보 로드 */
    function loadItemList() {
        var params = {
            "srch_pjt_no": $("#srchPjtNo").val()
            , "srch_pri_seq": $("#srchPriSeq").val()
        };

        $.ajax({
            type: "POST",
            url: "/cube_bta/tpmswork/ep/eep/mailing/keyTaskMailing/selectKeyTaskLogItemList",
            contentType: "application/json+lego; charset=UTF-8",
            data: JSON.stringify(params),
            success: function(json) {
                var html = '<option value="" selected>전체</option>';
                var list = json.list;
                if (list != null) {
                    for (var i = 0; i < list.length; i++) {
                        html += '<option value="' + list[i].pri_dtl_seq + '">' + list[i].pri_mng_item_sub_nm + '</option>';
                    }
                }
                $("#srchPriDtlSeq").html(html);
                $("#srchPriDtlSeq").selectpicker("refresh");
            }
        });
    }

    /* 상세 모달 오픈 */
    function openDtlModal(logSeq) {
        var params = { "log_seq": logSeq };

        $.ajax({
            type: "POST",
            url: "/cube_bta/tpmswork/ep/eep/mailing/keyTaskMailing/selectKeyTaskLogDtlList",
            contentType: "application/json+lego; charset=UTF-8",
            data: JSON.stringify(params),
            success: function(json) {
                var info = json.info;
                var list = json.list;

                /* 요약 정보 */
                /* [수정5] 프로젝트명 옆에 프로젝트번호(소속 프로젝트인 경우만), 부서코드, 공종코드 추가
                   ※ info.pjt_no / info.rcvr_dept_cd / info.rcvr_displn_cd 이 selectKeyTaskLogDtlList 쿼리(info 서브셀렉트)에
                     이미 내려오는지 확실하지 않음 - 없으면 XML 쪽에 컬럼 추가부터 해야 함 */
                var pjtNmHtml = nvl(info.pjt_short_name);
                if (info.pjt_no != null && info.pjt_no != "") {
                    pjtNmHtml += " (" + info.pjt_no + ")";
                }

                var displnHtml = nvl(info.rcvr_displn_nm);
                if (info.rcvr_displn_cd != null && info.rcvr_displn_cd != "") {
                    displnHtml += "(" + info.rcvr_displn_cd + ")";
                }

                var deptHtml = nvl(info.rcvr_dept_nm);
                if (info.rcvr_dept_cd != null && info.rcvr_dept_cd != "") {
                    deptHtml += "(" + info.rcvr_dept_cd + ")";
                }

                var infoHtml = "";
                infoHtml += '<div><span class="lbl">수신자</span>' + nvl(info.rcvr_nm) + ' (' + nvl(info.rcvr_empno) + ') / '
                        + pjtNmHtml + ' / ' + deptHtml + ' / ' + displnHtml + '</div>';
                infoHtml += '<div><span class="lbl">메일유형</span>' + nvl(info.mail_type_nm)
                        + ' &nbsp;|&nbsp; 총 ' + nvl(info.item_cnt) + '건'
                        + ' (즉시 ' + nvl(info.immd_cnt) + ' / 만회 ' + nvl(info.rcvy_cnt) + ' / 조기 ' + nvl(info.erly_cnt) + ')</div>';
                infoHtml += '<div><span class="lbl">제목</span>' + nvl(info.mail_title) + '</div>';
                $("#dtlInfoBox").html(infoHtml);

                /* 상세 항목 표 */
                var tbody = "";
                if (list != null) {
                    for (var i = 0; i < list.length; i++) {
                        var d = list[i];
                        tbody += '<tr>';
                        tbody += '<td class="dtl-c">' + nvl(d.item_no) + '</td>';
                        tbody += '<td class="dtl-c">' + nvl(d.pjt_short_name) + '</td>';
                        tbody += '<td class="dtl-c">' + nvl(d.owner_gbn_nm) + '</td>';
                        tbody += '<td>' + nvl(d.view_nm) + '</td>';
                        tbody += '<td>' + nvl(d.view_keytask_nm) + '</td>';
                        tbody += '<td class="dtl-c">' + nvl(d.view_displn_nm) + '</td>';
                        tbody += '<td class="dtl-c">' + nvl(d.plan_dt_nm) + '</td>';
                        tbody += '<td class="dtl-c">' + nvl(d.stage_nm) + '</td>';
                        tbody += '<td class="dtl-c">' + nvl(d.dsn_comp) + '</td>';
                        tbody += '<td class="dtl-c">' + nvl(d.comp_limit) + '</td>';
                        tbody += '<td>' + nvl(d.status_nm) + '</td>';
                        tbody += '<td>' + nvl(d.action_nm) + '</td>';
                        tbody += '</tr>';
                    }
                }
                $("#dtlTableBody").html(tbody);

                /* 메일 본문 미리보기 (iframe 으로 격리하여 화면 CSS 영향 제거) */
                var preview = document.getElementById("mailPreview");
                var doc = preview.contentDocument || preview.contentWindow.document;
                doc.open();
                doc.write('<html><head><meta charset="UTF-8"></head><body style="margin:0;">');
                doc.write(info.mail_body != null ? info.mail_body : '(본문 없음)');
                doc.write('</body></html>');
                doc.close();

                /* 첫번째 탭 활성화 후 모달 오픈 */
                $('#dtlTab a[href="#tabItem"]').tab('show');
                $("#logDtlModal").modal("show");
            }
        });
    }

    function nvl(v) {
        return (v == null || v == "null") ? "" : v;
    }
</script>
