    /** 카드 래핑: 배너 + 리드문구 + 본문 + 푸터 */
    public static String wrap(String headText, String innerHtml) {
        StringBuilder sb = new StringBuilder(4096);
        sb.append("<div style=\"").append(S_WRAP).append("\">");
        sb.append("<div style=\"").append(S_CARD).append("\">");
        sb.append(banner(headText));
        sb.append("<div style=\"").append(S_BODY_PAD).append("\">");
        sb.append("<p style=\"").append(S_P).append("\">").append(LEAD_TEXT).append("</p>");
        sb.append(innerHtml);
        sb.append("<p style=\"").append(S_FOOT).append("\">").append(FOOT_TEXT).append("</p>");
        sb.append("</div></div></div>");
        return sb.toString();
    }

    /* ============================================================
