package com.secl.pms.batch.vo;

import java.util.Comparator;
import java.util.Map;

/**
 * EEP 설계진도 Risk Warning 알림 대상 항목 VO
 * Processor 조회 결과 1행 + OWNER_GBN(KEYTASK/ITEM) 조합으로 생성
 */
public class EepAlertItemVo {

    /* ===== 구분값 상수 ===== */
    public static final String GBN_KEYTASK = "KEYTASK";
    public static final String GBN_ITEM    = "ITEM";

    public static final String LVL_IMMD = "IMMD"; // 즉시조치 (D-1, D-2)
    public static final String LVL_RCVY = "RCVY"; // 만회조치 (D-4, D-3)
    public static final String LVL_ERLY = "ERLY"; // 조기점검 (D-6, D-5)

    /* ===== Processor 조회 결과 ===== */
    private String pjtNo;
    private String vOrder;
    private String priSeq;
    private String priDtlSeq;
    private String mngItemNo;           // 관리항목번호 (MST)
    private String priMngItemNm;        // Key Task명
    private String priMngItemSubNm;     // 관리항목명
    private String planDt;
    private String mstDisplnCd;
    private String mstDisplnNm;
    private String majDisplnCd;
    private String displnNm;
    private String mstDsnComp;
    private String dsnComp;
    private int    weeksBefore;
    private int    compLimit;
    private String ver;                 // V1 / V2 / -
    private String mstUnderYn;
    private String dtlUnderYn;

    /* ===== Writer 파생 ===== */
    private String ownerGbn;            // KEYTASK / ITEM
    private String actionLvl;           // IMMD / RCVY / ERLY
    private int    sortLvl;             // 1=D-1V1, 2=D-1V2, 3=D-2, 4=D-4/3, 5=D-6/5

    /* ===== 팩토리 ===== */
    public static EepAlertItemVo create(Map<String, Object> row, String ownerGbn) {
        EepAlertItemVo vo = new EepAlertItemVo();

        vo.pjtNo            = str(row.get("pjtNo"));
        vo.vOrder           = str(row.get("vOrder"));
        vo.priSeq           = str(row.get("priSeq"));
        vo.priDtlSeq        = str(row.get("priDtlSeq"));
        vo.mngItemNo        = str(row.get("mngItemNo"));
        vo.priMngItemNm     = str(row.get("priMngItemNm"));
        vo.priMngItemSubNm  = str(row.get("priMngItemSubNm"));
        vo.planDt           = str(row.get("planDt"));
        vo.mstDisplnCd      = str(row.get("mstDisplnCd"));
        vo.mstDisplnNm      = str(row.get("mstDisplnNm"));
        vo.majDisplnCd      = str(row.get("majDisplnCd"));
        vo.displnNm         = str(row.get("displnNm"));
        vo.mstDsnComp       = str(row.get("mstDsnComp"));
        vo.dsnComp          = str(row.get("dsnComp"));
        vo.weeksBefore      = num(row.get("weeksBefore"));
        vo.compLimit        = num(row.get("compLimit"));
        vo.ver              = str(row.get("ver"));
        vo.mstUnderYn       = str(row.get("mstUnderYn"));
        vo.dtlUnderYn       = str(row.get("dtlUnderYn"));

        vo.ownerGbn = ownerGbn;
        vo.applyDerived();
        return vo;
    }

    private void applyDerived() {
        if (weeksBefore <= 2) {
            actionLvl = LVL_IMMD;
        } else if (weeksBefore <= 4) {
            actionLvl = LVL_RCVY;
        } else {
            actionLvl = LVL_ERLY;
        }

        if (weeksBefore == 1) {
            sortLvl = "V2".equals(ver) ? 2 : 1;
        } else if (weeksBefore == 2) {
            sortLvl = 3;
        } else if (weeksBefore == 3 || weeksBefore == 4) {
            sortLvl = 4;
        } else {
            sortLvl = 5;
        }
    }

    /* ===== 구분별 표시값 ===== */
    public boolean isKeyTask() {
        return GBN_KEYTASK.equals(ownerGbn);
    }

    /** 표 '구분' 컬럼 */
    public String getTypeNm() {
        return isKeyTask() ? "Key Task" : "관리항목";
    }

    /** 표 '명칭' 컬럼 */
    public String getViewName() {
        return isKeyTask() ? priMngItemNm : priMngItemSubNm;
    }

    /** 표 '관련 Key Task' 컬럼 (Key Task 건이면 '-') */
    public String getViewKeyTask() {
        return isKeyTask() ? "-" : priMngItemNm;
    }

    /** 해당 건의 완성도 */
    public String getViewComp() {
        return isKeyTask() ? mstDsnComp : dsnComp;
    }

    /** 해당 건의 공종코드 */
    public String getViewDisplnCd() {
        return isKeyTask() ? mstDisplnCd : majDisplnCd;
    }

    /** 해당 건의 공종명 */
    public String getViewDisplnNm() {
        return isKeyTask() ? mstDisplnNm : displnNm;
    }

    /** 미달여부 */
    public boolean isUnder() {
        return isKeyTask() ? "Y".equals(mstUnderYn) : "Y".equals(dtlUnderYn);
    }

    /* ===== 표기용 문구 ===== */

    /** 단계: "D-1주 (V1)" / "D-2주" */
    public String getStageNm() {
        if (weeksBefore == 1) {
            return "D-1주 (" + ("V2".equals(ver) ? "V2" : "V1") + ")";
        }
        return "D-" + weeksBefore + "주";
    }

    /** 상태 */
    public String getStatusNm() {
        if (isKeyTask()) {
            if (weeksBefore <= 2) {
                return "즉시 조치 필요";
            } else if (weeksBefore <= 4) {
                return "만회 조치 필요";
            }
            return "조기 점검 필요";
        }

        if (weeksBefore == 1) {
            return "V2".equals(ver) ? "진행율 저조 - 완료 전 최종 점검" : "진행율 저조 - 품질·일정 리스크";
        } else if (weeksBefore == 2) {
            return "진행율 저조 - 즉시 조치 필요";
        } else if (weeksBefore <= 4) {
            return "진행율 저조 지속 - 만회 조치 필요";
        }
        return "진행율 저조 - 조기 점검 필요";
    }

    /** 필요 조치 */
    public String getActionNm() {
        if (isKeyTask()) {
            if (weeksBefore <= 2) {
                return "즉시 검토 및 조치, 관련 담당자 협의 필수";
            } else if (weeksBefore <= 4) {
                return "지체 없이 완료 조치, LE와 협의";
            }
            return "하위 관리항목 조기 점검";
        }

        if (weeksBefore <= 2) {
            return "즉시 완료 조치, 프로젝트 LE 협의 필수";
        } else if (weeksBefore <= 4) {
            return "지체 없이 완료 조치, LE와 협의";
        }
        return "조기 점검 및 완료 조치";
    }

    /* ===== 그룹핑/중복제거 키 ===== */
    /**
     * Key Task 건은 상세 단위가 아니므로 priDtlSeq를 제외한다.
     * (제외하지 않으면 하위 상세 개수만큼 같은 Key Task가 중복됨)
     */
    public String getItemKey() {
        StringBuilder sb = new StringBuilder();
        sb.append(pjtNo).append("|").append(priSeq).append("|");
        if (isKeyTask()) {
            sb.append("MST");
        } else {
            sb.append(priDtlSeq);
        }
        sb.append("|").append(ownerGbn);
        sb.append("|").append(weeksBefore);
        sb.append("|").append(ver);
        return sb.toString();
    }

    /* ===== 정렬: 단계 우선, 동일단계면 Key Task 우선 ===== */
    public static final Comparator<EepAlertItemVo> SORT = new Comparator<EepAlertItemVo>() {
        public int compare(EepAlertItemVo a, EepAlertItemVo b) {
            if (a.sortLvl != b.sortLvl) {
                return a.sortLvl - b.sortLvl;
            }
            int ga = a.isKeyTask() ? 0 : 1;
            int gb = b.isKeyTask() ? 0 : 1;
            if (ga != gb) {
                return ga - gb;
            }
            return nvl(a.getViewName()).compareTo(nvl(b.getViewName()));
        }
    };

    /* ===== util ===== */
    private static String str(Object o) {
        return o == null ? "" : String.valueOf(o);
    }

    private static int num(Object o) {
        if (o == null) {
            return 0;
        }
        try {
            String s = String.valueOf(o).trim();
            int dot = s.indexOf('.');
            if (dot > -1) {
                s = s.substring(0, dot);
            }
            return Integer.parseInt(s);
        } catch (Exception e) {
            return 0;
        }
    }

    private static String nvl(String s) {
        return s == null ? "" : s;
    }

    /* ===== getter / setter ===== */
    public String getPjtNo() { return pjtNo; }
    public void setPjtNo(String pjtNo) { this.pjtNo = pjtNo; }

    public String getVOrder() { return vOrder; }
    public void setVOrder(String vOrder) { this.vOrder = vOrder; }

    public String getPriSeq() { return priSeq; }
    public void setPriSeq(String priSeq) { this.priSeq = priSeq; }

    public String getPriDtlSeq() { return priDtlSeq; }
    public void setPriDtlSeq(String priDtlSeq) { this.priDtlSeq = priDtlSeq; }

    public String getMngItemNo() { return mngItemNo; }
    public void setMngItemNo(String mngItemNo) { this.mngItemNo = mngItemNo; }

    public String getPriMngItemNm() { return priMngItemNm; }
    public void setPriMngItemNm(String priMngItemNm) { this.priMngItemNm = priMngItemNm; }

    public String getPriMngItemSubNm() { return priMngItemSubNm; }
    public void setPriMngItemSubNm(String priMngItemSubNm) { this.priMngItemSubNm = priMngItemSubNm; }

    public String getPlanDt() { return planDt; }
    public void setPlanDt(String planDt) { this.planDt = planDt; }

    public String getMstDisplnCd() { return mstDisplnCd; }
    public void setMstDisplnCd(String mstDisplnCd) { this.mstDisplnCd = mstDisplnCd; }

    public String getMstDisplnNm() { return mstDisplnNm; }
    public void setMstDisplnNm(String mstDisplnNm) { this.mstDisplnNm = mstDisplnNm; }

    public String getMajDisplnCd() { return majDisplnCd; }
    public void setMajDisplnCd(String majDisplnCd) { this.majDisplnCd = majDisplnCd; }

    public String getDisplnNm() { return displnNm; }
    public void setDisplnNm(String displnNm) { this.displnNm = displnNm; }

    public String getMstDsnComp() { return mstDsnComp; }
    public void setMstDsnComp(String mstDsnComp) { this.mstDsnComp = mstDsnComp; }

    public String getDsnComp() { return dsnComp; }
    public void setDsnComp(String dsnComp) { this.dsnComp = dsnComp; }

    public int getWeeksBefore() { return weeksBefore; }
    public void setWeeksBefore(int weeksBefore) { this.weeksBefore = weeksBefore; }

    public int getCompLimit() { return compLimit; }
    public void setCompLimit(int compLimit) { this.compLimit = compLimit; }

    public String getVer() { return ver; }
    public void setVer(String ver) { this.ver = ver; }

    public String getMstUnderYn() { return mstUnderYn; }
    public void setMstUnderYn(String mstUnderYn) { this.mstUnderYn = mstUnderYn; }

    public String getDtlUnderYn() { return dtlUnderYn; }
    public void setDtlUnderYn(String dtlUnderYn) { this.dtlUnderYn = dtlUnderYn; }

    public String getOwnerGbn() { return ownerGbn; }
    public void setOwnerGbn(String ownerGbn) { this.ownerGbn = ownerGbn; }

    public String getActionLvl() { return actionLvl; }
    public void setActionLvl(String actionLvl) { this.actionLvl = actionLvl; }

    public int getSortLvl() { return sortLvl; }
    public void setSortLvl(int sortLvl) { this.sortLvl = sortLvl; }
}
