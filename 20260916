	/**
	 * 관리항목 알람메일 발송로그 화면
	 * @param params
	 * @param request
	 * @return
	 * @throws Exception
	 */
	@RequestMapping(value="/keyTaskMailing/keyTaskLogMng")
	public ModelAndView keyTaskLogMng(@RequestBody TpmsMap params, HttpServletRequest request, HttpServletResponse response) throws Exception {
		ModelAndView mav = new ModelAndView();
		mav.setViewName(uiResourceRoot+request.getServletPath());

		/* 프로젝트 목록 */
		mav.addObject("pjtList", tpmsWorkEepPrjMgrService.selectTpmsWorkEepUsePrjList(params));

		/* 공종 목록 (맨 앞에 '전공종' 추가) */
		List<Map<String, Object>> displnList = eepCommonService.selectDisplineList(params);
		List<Map<String, Object>> displnDtlList = new ArrayList<Map<String, Object>>();
		Map<String, Object> allItem = new HashMap<String, Object>();
		allItem.put("displn_cd", "ALL");
		allItem.put("displn_nm", "전공종");
		displnDtlList.add(allItem);
		displnDtlList.addAll(displnList);
		mav.addObject("disciplineDtlList", displnDtlList);

		/* 검색 기본일자 : 오늘 ~ 오늘 */
		String today = DateUtils.getDay("", 0, "yyyyMMdd");
		mav.addObject("yyyymmdd_from", today);
		mav.addObject("yyyymmdd_to", today);

		mav.addAllObjects(params);
		return mav;
	}

