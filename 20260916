/* ============================================================================
 * [1] XML — 기존 tpms-work-ep-eep-mailing.xml 에 추가
 *     (namespace는 기존 파일 것 그대로 사용)
 * ============================================================================ */

	<!-- ========================================================
	     관리항목 알람메일 발송로그 > 실행시각 목록
	     ======================================================== -->
	<select id="selectKeyTaskLogRunTimeList" parameterType="hashMap" resultType="snakeCaseMap">
	/* tpms-work-ep-eep-mailing.xml selectKeyTaskLogRunTimeList */
		SELECT
			RUN_KEY
			, SUBSTR(RUN_KEY, 1, 4) || '-' || SUBSTR(RUN_KEY, 5, 2) || '-' || SUBSTR(RUN_KEY, 7, 2)
			  || ' ' || SUBSTR(RUN_KEY, 9, 2) || ':' || SUBSTR(RUN_KEY, 11, 2)
			  || ' (' || MAIL_CNT || '건)' AS RUN_NM
		FROM (
			SELECT
				SUBSTR(REG_DATE, 1, 12) AS RUN_KEY		/* YYYYMMDDHH24MI. 분 단위로 1회 실행 취급 */
				, COUNT(*) AS MAIL_CNT
			FROM
				SEI_BK.BTA_EP_E_PRI_NOTI_LOG
			WHERE 1 = 1
			<if test="srch_from_dt != null and srch_from_dt != ''">
				AND BATCH_DT <![CDATA[ >= ]]> REPLACE(#{srch_from_dt}, '.', '')
			</if>
			<if test="srch_to_dt != null and srch_to_dt != ''">
				AND BATCH_DT <![CDATA[ <= ]]> REPLACE(#{srch_to_dt}, '.', '')
			</if>
			GROUP BY SUBSTR(REG_DATE, 1, 12)
		)
		ORDER BY RUN_KEY DESC
	</select>

	<!-- ========================================================
	     관리항목 알람메일 발송로그 > Key Task 목록 (로그에 존재하는 것만)
	     ======================================================== -->
	<select id="selectKeyTaskLogTaskList" parameterType="hashMap" resultType="snakeCaseMap">
	/* tpms-work-ep-eep-mailing.xml selectKeyTaskLogTaskList */
		SELECT DISTINCT
			DTL.PRI_SEQ
			, DTL.PRI_MNG_ITEM_NM
		FROM
			SEI_BK.BTA_EP_E_PRI_NOTI_LOG_DTL DTL
		WHERE
			DTL.PRI_MNG_ITEM_NM IS NOT NULL
		<if test="srch_pjt_no != null and srch_pjt_no != ''">
			AND DTL.PJT_NO = #{srch_pjt_no}
		</if>
		ORDER BY DTL.PRI_MNG_ITEM_NM
	</select>

	<!-- ========================================================
	     관리항목 알람메일 발송로그 > 하위 관리항목 목록 (로그에 존재하는 것만)
	     ======================================================== -->
	<select id="selectKeyTaskLogItemList" parameterType="hashMap" resultType="snakeCaseMap">
	/* tpms-work-ep-eep-mailing.xml selectKeyTaskLogItemList */
		SELECT DISTINCT
			DTL.PRI_DTL_SEQ
			, DTL.PRI_MNG_ITEM_SUB_NM
		FROM
			SEI_BK.BTA_EP_E_PRI_NOTI_LOG_DTL DTL
		WHERE
			DTL.OWNER_GBN = 'ITEM'					/* Key Task 건은 하위 관리항목이 아니므로 제외 */
			AND DTL.PRI_MNG_ITEM_SUB_NM IS NOT NULL
		<if test="srch_pjt_no != null and srch_pjt_no != ''">
			AND DTL.PJT_NO = #{srch_pjt_no}
		</if>
		<if test="srch_pri_seq != null and srch_pri_seq != ''">
			AND DTL.PRI_SEQ = #{srch_pri_seq}
		</if>
		ORDER BY DTL.PRI_MNG_ITEM_SUB_NM
	</select>

	<!-- ========================================================
	     관리항목 알람메일 발송로그 > 목록 (메일 1통 = 1행)
	     ======================================================== -->
	<select id="selectKeyTaskLogList" parameterType="hashMap" resultType="snakeCaseMap">
	/* tpms-work-ep-eep-mailing.xml selectKeyTaskLogList */
		SELECT
			L.LOG_SEQ
			, L.BATCH_DT
			, SUBSTR(L.BATCH_DT, 1, 4) || '-' || SUBSTR(L.BATCH_DT, 5, 2) || '-' || SUBSTR(L.BATCH_DT, 7, 2) AS BATCH_DT_NM
			, SUBSTR(L.REG_DATE, 9, 2) || ':' || SUBSTR(L.REG_DATE, 11, 2) AS RUN_TM
			, L.RCVR_EMPNO
			, L.RCVR_NM
			, L.RCVR_GBN
			, CASE L.RCVR_GBN
				WHEN 'LE' THEN 'LE'
				WHEN 'GROUP_MANAGER' THEN '그룹장'
				WHEN 'TEAM_MANAGER' THEN '팀장'
				ELSE L.RCVR_GBN
			  END AS RCVR_GBN_NM
			, L.RCVR_DEPT_NM
			, L.RCVR_DISPLN_NM
			, L.MAIL_TYPE
			, CASE L.MAIL_TYPE
				WHEN 'ITEM' THEN '관리항목(단건)'
				WHEN 'KEYTASK' THEN 'Key Task(단건)'
				WHEN 'DIGEST' THEN 'Digest'
				WHEN 'MULTI' THEN 'Multi PJT'
				ELSE L.MAIL_TYPE
			  END AS MAIL_TYPE_NM
			, L.MAIL_LANG
			, L.PJT_CNT
			, L.ITEM_CNT
			, L.IMMD_CNT
			, L.RCVY_CNT
			, L.ERLY_CNT
			, L.IMMD_CNT || ' / ' || L.RCVY_CNT || ' / ' || L.ERLY_CNT AS ACTION_CNT_NM
			, L.MAIL_TITLE
			, L.SEND_YN

			/* 해당 메일에 포함된 프로젝트 목록 */
			, (
				SELECT LISTAGG(X.V_ORDER, ', ') WITHIN GROUP (ORDER BY X.V_ORDER)
				FROM (
					SELECT DISTINCT D2.V_ORDER
					FROM SEI_BK.BTA_EP_E_PRI_NOTI_LOG_DTL D2
					WHERE D2.LOG_SEQ = L.LOG_SEQ
				) X
			  ) AS PJT_NMS
		FROM
			SEI_BK.BTA_EP_E_PRI_NOTI_LOG L
		WHERE 1 = 1
		<if test="srch_from_dt != null and srch_from_dt != ''">
			AND L.BATCH_DT <![CDATA[ >= ]]> REPLACE(#{srch_from_dt}, '.', '')
		</if>
		<if test="srch_to_dt != null and srch_to_dt != ''">
			AND L.BATCH_DT <![CDATA[ <= ]]> REPLACE(#{srch_to_dt}, '.', '')
		</if>
		<if test="srch_run_key != null and srch_run_key != ''">
			AND SUBSTR(L.REG_DATE, 1, 12) = #{srch_run_key}		/* 특정 실행 회차 */
		</if>
		<if test="srch_mail_type != null and srch_mail_type != ''">
			AND L.MAIL_TYPE = #{srch_mail_type}
		</if>
		<if test="srch_rcvr_gbn != null and srch_rcvr_gbn != ''">
			AND L.RCVR_GBN = #{srch_rcvr_gbn}
		</if>
		<if test="srch_send_yn != null and srch_send_yn != ''">
			AND NVL(L.SEND_YN, 'N') = #{srch_send_yn}
		</if>
		<if test="srch_rcvr != null and srch_rcvr != ''">
			AND (L.RCVR_EMPNO LIKE '%' || #{srch_rcvr} || '%'
			  OR L.RCVR_NM LIKE '%' || #{srch_rcvr} || '%')
		</if>

		<!--
			프로젝트 / 공종 / Key Task / 관리항목은 마스터에 없고 상세에만 존재함.
			따라서 EXISTS 로 "해당 조건에 맞는 항목이 1건이라도 포함된 메일"을 필터링한다.
			(Digest 메일이면 조건에 맞지 않는 다른 항목도 함께 포함되어 있을 수 있음)
		-->
		<if test="(srch_pjt_no != null and srch_pjt_no != '')
			   or (srch_displn_cd != null and srch_displn_cd != '' and srch_displn_cd != 'ALL')
			   or (srch_pri_seq != null and srch_pri_seq != '')
			   or (srch_pri_dtl_seq != null and srch_pri_dtl_seq != '')">
			AND EXISTS (
				SELECT 1
				FROM SEI_BK.BTA_EP_E_PRI_NOTI_LOG_DTL DTL
				WHERE DTL.LOG_SEQ = L.LOG_SEQ
				<if test="srch_pjt_no != null and srch_pjt_no != ''">
					AND DTL.PJT_NO = #{srch_pjt_no}
				</if>
				<if test="srch_pri_seq != null and srch_pri_seq != ''">
					AND DTL.PRI_SEQ = #{srch_pri_seq}
				</if>
				<if test="srch_pri_dtl_seq != null and srch_pri_dtl_seq != ''">
					AND DTL.PRI_DTL_SEQ = #{srch_pri_dtl_seq}
					AND DTL.OWNER_GBN = 'ITEM'		/* 하위 관리항목 조건이므로 Key Task 건은 제외 */
				</if>
				<if test="srch_displn_cd != null and srch_displn_cd != '' and srch_displn_cd != 'ALL'">
					<!--
						수신자 공종(RCVR_DISPLN_CD)은 복수 담당 시 'J1,J2' 형태로 저장되어
						정확한 매칭이 어려우므로, 상세의 공종코드로 비교한다.
						구분(OWNER_GBN)에 따라 참조할 공종 컬럼이 다름.
					-->
					AND (
						(DTL.OWNER_GBN = 'KEYTASK' AND DTL.MST_DISPLN_CD = #{srch_displn_cd})
						OR
						(DTL.OWNER_GBN = 'ITEM' AND DTL.MAJ_DISPLN_CD = #{srch_displn_cd})
					)
				</if>
			)
		</if>
		ORDER BY
			L.BATCH_DT DESC
			, L.REG_DATE DESC
			, L.MAIL_TYPE
			, L.RCVR_NM
	</select>

	<!-- ========================================================
	     관리항목 알람메일 발송로그 > 상세 항목 (메일 본문 표에 들어간 항목)
	     ======================================================== -->
	<select id="selectKeyTaskLogDtlList" parameterType="hashMap" resultType="snakeCaseMap">
	/* tpms-work-ep-eep-mailing.xml selectKeyTaskLogDtlList */
		SELECT
			DTL.LOG_SEQ
			, DTL.ITEM_NO
			, DTL.PJT_NO
			, DTL.V_ORDER
			, DTL.PRI_SEQ
			, DTL.PRI_MNG_ITEM_NM
			, DTL.MST_DISPLN_CD
			, DTL.MST_DISPLN_NM
			, DTL.PRI_DTL_SEQ
			, DTL.PRI_MNG_ITEM_SUB_NM
			, DTL.MAJ_DISPLN_CD
			, DTL.DISPLN_NM
			, DTL.OWNER_GBN
			, CASE DTL.OWNER_GBN WHEN 'KEYTASK' THEN 'Key Task' ELSE '관리항목' END AS OWNER_GBN_NM

			/* 표 '명칭' / '관련 Key Task' 컬럼은 구분에 따라 표시값이 달라짐 */
			, CASE WHEN DTL.OWNER_GBN = 'KEYTASK' THEN DTL.PRI_MNG_ITEM_NM
				   ELSE DTL.PRI_MNG_ITEM_SUB_NM END AS VIEW_NM
			, CASE WHEN DTL.OWNER_GBN = 'KEYTASK' THEN '-'
				   ELSE DTL.PRI_MNG_ITEM_NM END AS VIEW_KEYTASK_NM
			, CASE WHEN DTL.OWNER_GBN = 'KEYTASK' THEN DTL.MST_DISPLN_NM
				   ELSE DTL.DISPLN_NM END AS VIEW_DISPLN_NM

			, DTL.PLAN_DT
			, SUBSTR(DTL.PLAN_DT, 1, 4) || '-' || SUBSTR(DTL.PLAN_DT, 5, 2) || '-' || SUBSTR(DTL.PLAN_DT, 7, 2) AS PLAN_DT_NM
			, DTL.WEEKS_BEFORE
			, DTL.VER
			, DTL.DSN_COMP
			, DTL.COMP_LIMIT
			, DTL.ACTION_LVL
			, DTL.STAGE_NM
			, DTL.STATUS_NM
			, DTL.ACTION_NM
		FROM
			SEI_BK.BTA_EP_E_PRI_NOTI_LOG_DTL DTL
		WHERE
			DTL.LOG_SEQ = #{log_seq}
		ORDER BY
			DTL.ITEM_NO
	</select>

	<!-- ========================================================
	     관리항목 알람메일 발송로그 > 메일 본문 조회 (미리보기용)
	     ======================================================== -->
	<select id="selectKeyTaskLogBody" parameterType="hashMap" resultType="snakeCaseMap">
	/* tpms-work-ep-eep-mailing.xml selectKeyTaskLogBody */
		SELECT
			L.LOG_SEQ
			, L.MAIL_TITLE
			, L.MAIL_BODY
			, L.RCVR_NM
			, L.RCVR_EMPNO
			, L.RCVR_DEPT_NM
			, L.RCVR_DISPLN_NM
			, L.ITEM_CNT
			, L.IMMD_CNT
			, L.RCVY_CNT
			, L.ERLY_CNT
			, CASE L.MAIL_TYPE
				WHEN 'ITEM' THEN '관리항목(단건)'
				WHEN 'KEYTASK' THEN 'Key Task(단건)'
				WHEN 'DIGEST' THEN 'Digest'
				WHEN 'MULTI' THEN 'Multi PJT'
				ELSE L.MAIL_TYPE
			  END AS MAIL_TYPE_NM
		FROM
			SEI_BK.BTA_EP_E_PRI_NOTI_LOG L
		WHERE
			L.LOG_SEQ = #{log_seq}
	</select>


