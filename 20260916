        "[Risk Warning] [Project: {{PJT}}] 금일 확인 필요 항목 {{N}}건 (즉시조치 포함)";
    public static final String KR_SUBJ_DIGEST_RCVY =
        "[Risk Warning] [Project: {{PJT}}] 금일 확인 필요 항목 {{N}}건 (만회조치 필요)";
    public static final String KR_SUBJ_DIGEST_ERLY =
        "[Risk Warning] [Project: {{PJT}}] 금일 확인 필요 항목 {{N}}건 (조기점검)";
    public static final String KR_SUBJ_DIGEST_NEAR =
        "[Risk Warning] [Project: {{PJT}}] 금일 확인 필요 항목 {{N}}건 – 완료 임박 포함";

    /* --- MultiProject Digest --- */
    public static final String KR_SUBJ_MULTI_IMMD =
        "[Risk Warning] [담당 프로젝트 {{M}}건] 금일 확인 필요 항목 {{N}}건 (즉시조치 포함)";
    public static final String KR_SUBJ_MULTI_RCVY =
        "[Risk Warning] [담당 프로젝트 {{M}}건] 금일 확인 필요 항목 {{N}}건 (만회조치 필요)";
    public static final String KR_SUBJ_MULTI_ERLY =
        "[Risk Warning] [담당 프로젝트 {{M}}건] 금일 확인 필요 항목 {{N}}건 (조기점검)";
    public static final String KR_SUBJ_MULTI_NEAR =
        "[Risk Warning] [담당 프로젝트 {{M}}건] 금일 확인 필요 항목 {{N}}건 – 완료 임박 포함";

    /* ============================================================
     *  제목 선택
     * ============================================================ */

    /** 단건 제목 선택 */
    public static String pickSingleSubject(boolean isKeyTask, int weeksBefore, String ver) {
        if (isKeyTask) {
            if (weeksBefore == 1) {
                return "V2".equals(ver) ? KR_SUBJ_KT_D1V2 : KR_SUBJ_KT_D1V1;
            } else if (weeksBefore == 2) {
                return KR_SUBJ_KT_D2;
            } else if (weeksBefore == 3 || weeksBefore == 4) {
                return KR_SUBJ_KT_D4;
            }
            return KR_SUBJ_KT_D6;
        }

        if (weeksBefore == 1) {
            return "V2".equals(ver) ? KR_SUBJ_ITEM_D1V2 : KR_SUBJ_ITEM_D1V1;
        } else if (weeksBefore == 2) {
            return KR_SUBJ_ITEM_D2;
        } else if (weeksBefore == 3 || weeksBefore == 4) {
            return KR_SUBJ_ITEM_D4;
        }
        return KR_SUBJ_ITEM_D6;
    }

    /**
     * Digest / MultiProject 제목 선택 (계단식)
     * D-1주 있으면 완료임박 > D-2 즉시조치 > D-4/3 만회조치 > D-6/5 조기점검
     */
    public static String pickDigestSubject(boolean hasD1, boolean hasD2, boolean hasD4, boolean isMulti) {
        if (hasD1) {
            return isMulti ? KR_SUBJ_MULTI_NEAR : KR_SUBJ_DIGEST_NEAR;
        } else if (hasD2) {
            return isMulti ? KR_SUBJ_MULTI_IMMD : KR_SUBJ_DIGEST_IMMD;
        } else if (hasD4) {
            return isMulti ? KR_SUBJ_MULTI_RCVY : KR_SUBJ_DIGEST_RCVY;
        }
        return isMulti ? KR_SUBJ_MULTI_ERLY : KR_SUBJ_DIGEST_ERLY;
    }
}













