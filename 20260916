<!-- 상세관리항목/마스터에 미달된 공종별 알림수신자(LE, 그룹장, 팀장) 목록 조회 -->
	<select id="selectEepPriDtlNotiRcvrList" parameterType="com.secl.pms.batch.vo.TargetVo" resultType="camelCaseMap">
	/* legacy-eep-mailing-mybatis.xml selectEepPriDtlNotiRcvrList */
		WITH EEP_PJT AS (
			SELECT
				CP.PJT_NO
				, CP.V_ORDER
			FROM
				BTA_EP_CM_PJT CP

				INNER JOIN SEI_BK.BK_TPMS_IF_BATCH_PJT_JOB JOB ON JOB.IF_ID = 'PMS_LEGACY_GetEpJob' /* EP 메인 job으로 지정 */
				AND JOB.PJT_NO = CP.PJT_NO

				INNER JOIN BK_TPMS_PJT_MAST TM ON TM.PJT_NO = JOB.PJT_NO
			WHERE
				CP.EP_TP = 'EEP'
				AND CP.USE_YN = 'Y'
			GROUP BY
				CP.PJT_NO
				, CP.V_ORDER
		),
		LATEST AS (
			SELECT
				H.PJT_NO
				, MAX(H.STD_DT) AS STD_DT
			FROM
				BK_TPMS_HR_STAFFING H
				INNER JOIN EEP_PJT P ON P.PJT_NO = H.PJT_NO
			GROUP BY H.PJT_NO
		),
		/* 공종코드 ROW 변환. 마스터(KeyTask) + 상세(관리항목) 각각 생성 */
		MAJ_DISC AS (
			/* 1) 관리항목 마스터 공종 - KeyTask Owner 발송용 */
			SELECT DISTINCT
				B.PJT_NO
				, B.PRI_SEQ
				, B.MNG_ITEM_NO
				, B.PRI_MNG_ITEM_NM
				, B.PRI_DTL_SEQ
				, B.DTL_MNG_ITEM_NO
				, B.PRI_MNG_ITEM_SUB_NM
				, 'KEYTASK' AS OWNER_GBN
				, CASE
					WHEN B.RAW_DISC_CD = 'J0' AND J0_EXP.J0_LVL = 1 THEN 'J1'
					WHEN B.RAW_DISC_CD = 'J0' AND J0_EXP.J0_LVL = 2 THEN 'J2'
					ELSE B.RAW_DISC_CD
				  END AS DISC_CD
			FROM (
				SELECT
					D.PJT_NO
					, D.PRI_SEQ
					, M.MNG_ITEM_NO			-- 관리항목번호 (MST)
					, M.PRI_MNG_ITEM_NM		-- 관리항목명 (MST)
					, D.PRI_DTL_SEQ
					, D.DTL_MNG_ITEM_NO		-- 관리항목번호 (DTL)
					, D.PRI_MNG_ITEM_SUB_NM	-- 관리항목명 (DTL)
					, M.DISPLN_CD AS RAW_DISC_CD	/* 마스터는 단일코드 (쉼표 없음) */
				FROM
					BTA_EP_E_PJT_PRI_DTL D
					INNER JOIN BTA_EP_E_PJT_PRI_MST M ON M.PJT_NO = D.PJT_NO
						AND M.PRI_SEQ = D.PRI_SEQ
				WHERE
					D.USE_YN = 'Y'			-- DTL 사용여부
					AND M.USE_YN = 'Y'		-- MST 사용여부
					AND M.PRI_TYPE IN ('ACT')	-- 관리항목이 TASK인것만
					AND
					<foreach collection="listParamMap" item="item" open="(" separator=" OR " close=")">
						(D.PJT_NO = #{item.pjtNo} AND D.PRI_SEQ = #{item.priSeq} AND D.PRI_DTL_SEQ = #{item.priDtlSeq})
					</foreach>
			) B

			/* J0 코드 확장: J0이면 J0_LVL 1,2 두 행 모두 매칭 → J1/J2 생성. J0 외 코드는 J0_LVL = 1인 행만 매칭 */
			INNER JOIN (
				SELECT 1 AS J0_LVL FROM DUAL
				UNION ALL
				SELECT 2 AS J0_LVL FROM DUAL
			) J0_EXP ON (
				B.RAW_DISC_CD = 'J0'
				OR J0_EXP.J0_LVL = 1
			)
			WHERE B.RAW_DISC_CD IS NOT NULL

			UNION

			/* 2) 상세관리항목 공종 - Item Owner 발송용 */
			SELECT DISTINCT
				B.PJT_NO
				, B.PRI_SEQ
				, B.MNG_ITEM_NO
				, B.PRI_MNG_ITEM_NM
				, B.PRI_DTL_SEQ
				, B.DTL_MNG_ITEM_NO
				, B.PRI_MNG_ITEM_SUB_NM
				, 'ITEM' AS OWNER_GBN
				, CASE
					WHEN B.RAW_DISC_CD = 'J0' AND J0_EXP.J0_LVL = 1 THEN 'J1'
					WHEN B.RAW_DISC_CD = 'J0' AND J0_EXP.J0_LVL = 2 THEN 'J2'
					ELSE B.RAW_DISC_CD
				  END AS DISC_CD
			FROM (
				SELECT
					D.PJT_NO
					, D.PRI_SEQ
					, M.MNG_ITEM_NO
					, M.PRI_MNG_ITEM_NM
					, D.PRI_DTL_SEQ
					, D.DTL_MNG_ITEM_NO
					, D.PRI_MNG_ITEM_SUB_NM
					/* MAJ_DISPLN_CD 내 쉼표로 구분된 코드 개수만큼 행 생성 */
					, TRIM(REGEXP_SUBSTR(D.MAJ_DISPLN_CD, '[^,]+', 1, LV.LVL)) AS RAW_DISC_CD
				FROM
					BTA_EP_E_PJT_PRI_DTL D
					INNER JOIN BTA_EP_E_PJT_PRI_MST M ON M.PJT_NO = D.PJT_NO
						AND M.PRI_SEQ = D.PRI_SEQ
					INNER JOIN (
						SELECT LEVEL AS LVL FROM DUAL CONNECT BY LEVEL <![CDATA[ <= ]]> 10
					) LV ON LV.LVL <![CDATA[ <= ]]> REGEXP_COUNT(D.MAJ_DISPLN_CD, '[^,]+')
				WHERE
					D.USE_YN = 'Y'
					AND M.USE_YN = 'Y'
					AND M.PRI_TYPE IN ('ACT')
					AND
					<foreach collection="listParamMap" item="item" open="(" separator=" OR " close=")">
						(D.PJT_NO = #{item.pjtNo} AND D.PRI_SEQ = #{item.priSeq} AND D.PRI_DTL_SEQ = #{item.priDtlSeq})
					</foreach>
			) B

			INNER JOIN (
				SELECT 1 AS J0_LVL FROM DUAL
				UNION ALL
				SELECT 2 AS J0_LVL FROM DUAL
			) J0_EXP ON (
				B.RAW_DISC_CD = 'J0'
				OR J0_EXP.J0_LVL = 1
			)
			WHERE B.RAW_DISC_CD IS NOT NULL
		),
		/* 공종별 LE */
		LE_LIST AS (
			SELECT
				H.PJT_NO
				, D.PRI_SEQ
				, D.MNG_ITEM_NO				-- 관리항목번호 (MST)
				, D.PRI_MNG_ITEM_NM			-- 관리항목명 (MST)
				, D.PRI_DTL_SEQ
				, D.DTL_MNG_ITEM_NO			-- 관리항목번호 (DTL)
				, D.PRI_MNG_ITEM_SUB_NM		-- 관리항목명 (DTL)
				, D.OWNER_GBN				-- KEYTASK / ITEM
				, D.DISC_CD
				, H.DISC_CD_NM
				, DEPT.UPDEPT	/* 상위 부서코드(D802195 면 화공사업본부 이기 때문에 프로젝트 부서를 의미. 그 외엔 전부 그룹임) */
				, H.DEPT
				, (CASE WHEN DEPT.UPDEPT = 'D802195' THEN 'N' ELSE 'Y' END) AS TEAM_YN
				, H.ASSIGN_JOB_CD
				, H.SDEPTNM
				, H.HNAME
				, H.EMPNO
				, 'LE' AS RECV_GBN
			FROM
				BK_TPMS_HR_STAFFING H /* 프로젝트 소속인력정보 */
				INNER JOIN ALL_DEPT_CODE DEPT ON DEPT.DEPT = H.DEPT /* 부서코드 */

				INNER JOIN LATEST L ON L.PJT_NO = H.PJT_NO
				AND L.STD_DT = H.STD_DT

				/* MAJ_DISC에 존재하는 공종코드만 필터링 */
				INNER JOIN MAJ_DISC D ON D.PJT_NO = H.PJT_NO
				AND D.DISC_CD = H.DISC_CD
			WHERE
				H.ASSIGN_JOB_CD = 'LE'
				AND H.FUNC_CD = 'E' /* 설계만 */
				AND TO_CHAR(SYSDATE, 'YYYYMM') BETWEEN H.ASSIGN_START_YM AND H.ASSIGN_END_YM
		),
		/* 팀 소속 LE의 그룹장 */
		GROUP_MANAGER AS (
			SELECT
				L.PJT_NO
				, L.PRI_SEQ
				, L.MNG_ITEM_NO
				, L.PRI_MNG_ITEM_NM
				, L.PRI_DTL_SEQ
				, L.DTL_MNG_ITEM_NO
				, L.PRI_MNG_ITEM_SUB_NM
				, L.OWNER_GBN
				, L.DISC_CD
				, L.DISC_CD_NM
				, L.UPDEPT
				, L.DEPT
				, L.TEAM_YN
				, L.ASSIGN_JOB_CD
				, L.SDEPTNM
				, B.CN AS HNAME
				, A.USER_SQ AS EMPNO
				, 'GROUP_MANAGER' AS RECV_GBN
			FROM
				LE_LIST L
				INNER JOIN TB_FR_DEPT_USER_MAP A ON A.DEPT_SQ = L.DEPT
				INNER JOIN SINGLE_USERINFO B ON B.EMPLOYEENUMBER = A.USER_SQ
			WHERE
				L.TEAM_YN = 'Y'
				AND B.TITLE = '그룹장'
		),
		/* 그룹 상위 팀의 팀장 */
		TEAM_MANAGER AS (
			SELECT
				L.PJT_NO
				, L.PRI_SEQ
				, L.MNG_ITEM_NO
				, L.PRI_MNG_ITEM_NM
				, L.PRI_DTL_SEQ
				, L.DTL_MNG_ITEM_NO
				, L.PRI_MNG_ITEM_SUB_NM
				, L.OWNER_GBN
				, L.DISC_CD
				, L.DISC_CD_NM
				, L.UPDEPT
				, L.DEPT
				, L.TEAM_YN
				, L.ASSIGN_JOB_CD
				, L.SDEPTNM
				, B.CN AS HNAME
				, A.USER_SQ AS EMPNO
				, 'TEAM_MANAGER' AS RECV_GBN
			FROM
				LE_LIST L
				INNER JOIN TB_FR_DEPT_USER_MAP A ON A.DEPT_SQ = L.UPDEPT
				INNER JOIN SINGLE_USERINFO B ON B.EMPLOYEENUMBER = A.USER_SQ
			WHERE
				L.TEAM_YN = 'Y'
				AND B.TITLE = '팀장'
		),
		RECV_LIST AS (
			SELECT * FROM LE_LIST
			UNION
			SELECT * FROM GROUP_MANAGER
			UNION
			SELECT * FROM TEAM_MANAGER
		)
		SELECT
			R.PJT_NO
			, R.PRI_SEQ
			, R.MNG_ITEM_NO				-- 관리항목번호 (MST)
			, R.PRI_MNG_ITEM_NM			-- 관리항목명 (MST)
			, R.PRI_DTL_SEQ
			, R.DTL_MNG_ITEM_NO			-- 관리항목번호 (DTL)
			, R.PRI_MNG_ITEM_SUB_NM		-- 관리항목명 (DTL)
			, R.OWNER_GBN				-- KEYTASK / ITEM
			, R.DISC_CD					-- 수신자 공종코드
			, R.DISC_CD_NM				-- 수신자 공종명
			, R.UPDEPT
			, R.DEPT
			, R.TEAM_YN
			, R.ASSIGN_JOB_CD
			, R.SDEPTNM
			, R.HNAME
			, R.EMPNO
			, R.RECV_GBN				-- LE / GROUP_MANAGER / TEAM_MANAGER
			, CASE WHEN NVL(S.FRNRYN, 'N') = 'Y' THEN 'EN' ELSE 'KR' END AS MAIL_LANG /* 외국인여부 */
		FROM
			RECV_LIST R
			LEFT OUTER JOIN ALL_SPEED_INSA S ON S.EMPNO = R.EMPNO
		ORDER BY
			R.PJT_NO
			, R.OWNER_GBN				-- KEYTASK 먼저
			, R.MNG_ITEM_NO NULLS LAST
			, R.DTL_MNG_ITEM_NO
	</select>
