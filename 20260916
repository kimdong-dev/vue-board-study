-- ============================================================
-- EEP 설계진도 Risk Warning 알림 발송 로그 (마스터)
-- 수신자 1명 = 메일 1통 = 1행
-- ============================================================
CREATE TABLE BTA_EP_E_PRI_NOTI_LOG (
    LOG_SEQ          NUMBER          NOT NULL,
    BATCH_DT         VARCHAR2(8)     NOT NULL,
    RCVR_EMPNO       VARCHAR2(20)    NOT NULL,
    RCVR_NM          VARCHAR2(100),
    RCVR_GBN         VARCHAR2(20),
    RCVR_DEPT_NM     VARCHAR2(200),
    RCVR_DISPLN_CD   VARCHAR2(100),
    RCVR_DISPLN_NM   VARCHAR2(300),
    MAIL_TYPE        VARCHAR2(20)    NOT NULL,
    MAIL_LANG        VARCHAR2(2),
    PJT_CNT          NUMBER(5),
    ITEM_CNT         NUMBER(5),
    IMMD_CNT         NUMBER(5),
    RCVY_CNT         NUMBER(5),
    ERLY_CNT         NUMBER(5),
    MAIL_TITLE       VARCHAR2(2000),
    MAIL_BODY        CLOB,
    SEND_YN          CHAR(1)         DEFAULT 'N',
    SEND_DT          DATE,
    REG_DT           DATE            DEFAULT SYSDATE,
    CONSTRAINT PK_BTA_EP_E_PRI_NOTI_LOG PRIMARY KEY (LOG_SEQ)
);

CREATE INDEX IX_BTA_EP_E_PRI_NOTI_LOG_01
    ON BTA_EP_E_PRI_NOTI_LOG (BATCH_DT, RCVR_EMPNO);

COMMENT ON TABLE  BTA_EP_E_PRI_NOTI_LOG IS 'EEP 설계진도 Risk Warning 알림 발송 로그(메일 단위)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.LOG_SEQ        IS '로그순번 (MAX+1 채번)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.BATCH_DT       IS '배치 기준일 YYYYMMDD';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.RCVR_EMPNO     IS '수신자 사번';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.RCVR_NM        IS '수신자 성명';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.RCVR_GBN       IS '수신자구분 LE/GROUP_MANAGER/TEAM_MANAGER';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.RCVR_DEPT_NM   IS '수신자 부서명';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.RCVR_DISPLN_CD IS '수신자 공종코드(복수시 콤마)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.RCVR_DISPLN_NM IS '수신자 공종명(복수시 슬래시)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.MAIL_TYPE      IS '메일유형 ITEM:관리항목단건, KEYTASK:KeyTask단건, DIGEST:단일PJT다이제스트, MULTI:복수PJT다이제스트';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.MAIL_LANG      IS '메일언어 KR/EN';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.PJT_CNT        IS '대상 프로젝트 수(M)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.ITEM_CNT       IS '대상 항목 수(N)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.IMMD_CNT       IS '즉시조치 건수(D-1, D-2)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.RCVY_CNT       IS '만회조치 건수(D-4, D-3)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.ERLY_CNT       IS '조기점검 건수(D-6, D-5)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.MAIL_TITLE     IS '메일제목';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.MAIL_BODY      IS '메일본문(HTML)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.SEND_YN        IS '실발송여부 (검증단계에서는 N)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.SEND_DT        IS '실발송일시';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG.REG_DT         IS '등록일시';

-- ============================================================
-- EEP 알림 발송 로그 상세 (메일 표에 들어간 항목)
-- ============================================================
CREATE TABLE BTA_EP_E_PRI_NOTI_LOG_DTL (
    LOG_SEQ             NUMBER          NOT NULL,
    ITEM_NO             NUMBER(5)       NOT NULL,
    PJT_NO              VARCHAR2(20),
    V_ORDER             VARCHAR2(20),
    PRI_SEQ             NUMBER,
    MNG_ITEM_NO         VARCHAR2(50),
    PRI_MNG_ITEM_NM     VARCHAR2(1000),
    MST_DISPLN_CD       VARCHAR2(10),
    MST_DISPLN_NM       VARCHAR2(100),
    PRI_DTL_SEQ         NUMBER,
    DTL_MNG_ITEM_NO     VARCHAR2(50),
    PRI_MNG_ITEM_SUB_NM VARCHAR2(1000),
    MAJ_DISPLN_CD       VARCHAR2(10),
    DISPLN_NM           VARCHAR2(100),
    OWNER_GBN           VARCHAR2(10),
    PLAN_DT             VARCHAR2(8),
    WEEKS_BEFORE        NUMBER(2),
    VER                 VARCHAR2(2),
    DSN_COMP            NUMBER(7,2),
    COMP_LIMIT          NUMBER(5),
    ACTION_LVL          VARCHAR2(10),
    STAGE_NM            VARCHAR2(50),
    STATUS_NM           VARCHAR2(200),
    ACTION_NM           VARCHAR2(300),
    CONSTRAINT PK_BTA_EP_E_PRI_NOTI_LOG_DTL PRIMARY KEY (LOG_SEQ, ITEM_NO)
);

CREATE INDEX IX_BTA_EP_E_PRI_NOTI_LOG_DTL_01
    ON BTA_EP_E_PRI_NOTI_LOG_DTL (PJT_NO, PRI_SEQ, PRI_DTL_SEQ);

COMMENT ON TABLE  BTA_EP_E_PRI_NOTI_LOG_DTL IS 'EEP 알림 발송 로그 - 대상 항목';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.LOG_SEQ             IS '로그순번(마스터 FK)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.ITEM_NO             IS '표 내 순번(정렬 적용 후)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.PJT_NO              IS '프로젝트번호';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.V_ORDER             IS '프로젝트 표기명';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.PRI_SEQ             IS '관리항목 마스터 순번';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.MNG_ITEM_NO         IS '관리항목번호(MST)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.PRI_MNG_ITEM_NM     IS 'Key Task명';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.MST_DISPLN_CD       IS 'Key Task 공종코드(J0은 J1/J2로 확장됨)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.MST_DISPLN_NM       IS 'Key Task 공종명';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.PRI_DTL_SEQ         IS '상세관리항목 순번';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.DTL_MNG_ITEM_NO     IS '관리항목번호(DTL)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.PRI_MNG_ITEM_SUB_NM IS '관리항목명';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.MAJ_DISPLN_CD       IS '관리항목 공종코드(J0은 J1/J2로 확장됨)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.DISPLN_NM           IS '관리항목 공종명';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.OWNER_GBN           IS '구분 KEYTASK:Key Task, ITEM:관리항목';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.PLAN_DT             IS 'Key Task 완료예정일';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.WEEKS_BEFORE        IS 'N주 전 (1,2,3,4,5,6)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.VER                 IS 'D-1주 버전 V1/V2, 그 외 -';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.DSN_COMP            IS '완성도(OWNER_GBN에 해당하는 값)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.COMP_LIMIT          IS '임계값(%)';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.ACTION_LVL          IS '조치수준 IMMD:즉시조치, RCVY:만회조치, ERLY:조기점검';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.STAGE_NM            IS '표기용 단계 (예: D-1주 (V1))';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.STATUS_NM           IS '표기용 상태';
COMMENT ON COLUMN BTA_EP_E_PRI_NOTI_LOG_DTL.ACTION_NM           IS '표기용 필요조치';


